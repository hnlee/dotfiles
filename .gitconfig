[user]
  name = Hana Lee
  email = hanalee07@gmail.com

[color]
  ui = true

[core]
  excludesfile = ~/.gitignore
  editor = nvim
  whitespace = fix,trailing-space
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  light = false
  syntax-theme = zenburn
  line-numbers = true
  side-by-side = true
  plus-style = syntax darkgreen
  plus-emph-style = syntax forestgreen
  minus-style = syntax darkred
  minus-emph-style = syntax firebrick
  zero-style = syntax dim
  file-style = yellow
  file-decoration-style = yellow ol
  hunk-header-style = blue
  hunk-header-decoration-style = blue box

[merge]
  conflictstyle = diff3

[rerere]
  enabled = true

[init]
  templateDir = ~/.config/git/template
  defaultBranch = main

[push]
  autoSetupRemote = true

[pull]
  rebase = true

[alias]
  whoami= !git config user.name && git config user.email
  defaultlog = log --graph --pretty=format:'%C(red)%h %C(yellow)(%cr) %C(reset)%s %C(blue)<%an>%C(green)%d'
  last5 = !git defaultlog -n5
  logs = !git defaultlog --branches="*"
  recommit = commit --amend --no-edit
  unstage = restore --staged
  diffstaged = diff --staged
  undo = reset HEAD~1
  cleanup = "!bash -c 'git fetch -p && git branch -vv | awk \"/: gone]/{print \\$1}\" | xargs git branch -D'"
  diffbranch = "!bash -c 'git diff $(git merge-base main head) head'"
  rebasebranch = "!bash -c 'git rebase -i $(git merge-base main head) head'"
  updatemain = "!bash -c 'git switch main && git pull --rebase && git switch - && git rebase -'"

[includeIf "gitdir:~/dev/"]
  path = ~/.gitconfig-work
